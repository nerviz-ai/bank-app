# Copy to `.env` (git and docker ignore it) and fill in. docker compose reads `.env` for the
# services, and application.yml imports it for the run on the host, so each value is written
# once. A password never goes in this file, and `.env` is never committed —
# .claude/rules/secrets.md.
#
# Required by the database service: `docker compose up` stops and names a missing one.
DB_PASSWORD=
#
# Optional. The defaults are in docker-compose.yml and application.yml; set one only to move
# a host port another project already holds, or to rename the database. Renaming DB_NAME or
# DB_USERNAME after the first start needs `docker compose down -v` (it deletes the data).
# DB_PORT=5432
# DB_NAME=
# DB_USERNAME=
# KAFKA_PORT=9092
# KAFKA_EXTERNAL_PORT=29092
#
# Required by the keycloak service (BL-05): admin console login and the two local test users
# of realm `bank` (`dpo`, `operator`). Passwords are never versioned.
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DPO_PASSWORD=
KEYCLOAK_OPERATOR_PASSWORD=
# KEYCLOAK_PORT=8180
